{
    // The name must match your Worker's name in Cloudflare (your address starts with "lumenn")
    "name": "lumen",
    "main": "worker/index.js",
    "compatibility_date": "2026-11-01",

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // Only /api/... requests run the Worker. Everything else is served straight from /public.
        "run_worker_first": ["/api/*"]
    },

    "vars": {
        // Your Render server. No slash at the end.
        "API_ORIGIN": "https://lumen-97t9.onrender.com"
    }
}
